# Configuración del Servidor - Clothes Empire
PORT=8080
NODE_ENV=development

# Base de Datos MongoDB
MONGODB_URI=mongodb://localhost:27017/clothes_empire

# JWT (Json Web Tokens)
JWT_SECRET=2231
JWT_EXPIRES_IN=1h

# Configuración de Email (Gmail) - Clothes Empire
EMAIL_USER=clothes.empire66@gmail.com
EMAIL_PASS= your_app_pass_here
EMAIL_SERVICE=gmail

# URL del Frontend
FRONTEND_URL=http://localhost:8080

# Configuración de Reset de Contraseña
RESET_TOKEN_EXPIRY=1h


# ==========================================
# Notas Importantes:
# ==========================================
# 1. JWT_SECRET: Debe ser una cadena larga y segura en producción
# 2. EMAIL_PASS: Para Gmail, usa una "App Password" si tienes 2FA activado
#    - Ve a: Configuración de Google > Seguridad > Contraseñas de aplicaciones
# 3. NODE_ENV: Usa 'production' en entornos de producción
# 4. MONGODB_URI: En producción, usa la URI de tu cluster de MongoDB Atlas
# ==========================================
